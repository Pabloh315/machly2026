<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Machly" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryVariant">@color/forest_2</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/leaf</item>
        <item name="colorSecondaryVariant">@color/lime</item>
        <item name="colorOnSecondary">@color/forest</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.Machly.Button</item>
        <item name="textInputStyle">@style/Widget.Machly.TextInput</item>
    </style>

    <style name="Widget.Machly.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">11dp</item>
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/lime</item>
    </style>

    <style name="Widget.Machly.Button.Secondary" parent="Widget.Machly.Button">
        <item name="backgroundTint">@color/leaf</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Machly.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/forest</item>
        <item name="android:textColor">@color/forest</item>
        <item name="cornerRadius">11dp</item>
    </style>

    <style name="Widget.Machly.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/forest</item>
        <item name="hintTextColor">@color/olive_hint</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="TextAppearance.Machly.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Machly.Brand" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/forest</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
